#!/usr/bin/env bash
# Make zsh the login shell. Idempotent and non-fatal: a locked-down cloud workstation may
# disallow chsh, so we warn rather than fail the whole `chezmoi apply`.
set -uo pipefail

{{ template "brew-shellenv.sh.tmpl" . }}

ZSH_BIN="$(command -v zsh || true)"
if [ -z "$ZSH_BIN" ]; then
  echo "WARN: zsh not found on PATH yet; skipping default-shell change" >&2
  exit 0
fi

CURRENT_SHELL="$(getent passwd "$USER" 2>/dev/null | cut -d: -f7 || dscl . -read /Users/"$USER" UserShell 2>/dev/null | awk '{print $2}')"
if [ "$CURRENT_SHELL" = "$ZSH_BIN" ]; then
  exit 0
fi

# Ensure the shell is registered in /etc/shells.
if ! grep -qx "$ZSH_BIN" /etc/shells 2>/dev/null; then
  echo "$ZSH_BIN" | sudo tee -a /etc/shells >/dev/null 2>&1 || \
    echo "WARN: could not add $ZSH_BIN to /etc/shells" >&2
fi

# Try unprivileged chsh first; on locked-down cloud workstations it needs a password, so fall
# back to sudo via chsh, then usermod. Everything runs non-interactively: `</dev/null` keeps
# chsh's PAM prompt from blocking, and `sudo -n` fails fast (instead of a hidden, hung prompt)
# when sudo isn't passwordless. All non-fatal — warn and move on if none work.
if chsh -s "$ZSH_BIN" </dev/null 2>/dev/null; then
  echo "==> Default shell changed to $ZSH_BIN (restart your session)"
elif sudo -n chsh -s "$ZSH_BIN" "$USER" </dev/null 2>/dev/null; then
  echo "==> Default shell changed to $ZSH_BIN via sudo (restart your session)"
elif command -v usermod >/dev/null 2>&1 && sudo -n usermod -s "$ZSH_BIN" "$USER" </dev/null 2>/dev/null; then
  echo "==> Default shell changed to $ZSH_BIN via usermod (restart your session)"
else
  echo "WARN: could not change default shell to zsh (chsh/usermod failed); set it manually" >&2
fi
