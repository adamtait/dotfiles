#!/usr/bin/env zsh
# ~/.zprofile — sourced for login shells, before ~/.zshrc. Bootstraps the package
# manager environment (Homebrew) so PATH is correct for login sessions.

{{ if eq .chezmoi.os "darwin" -}}
{{   if eq .chezmoi.arch "arm64" -}}
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
{{   else -}}
[ -x /usr/local/bin/brew ] && eval "$(/usr/local/bin/brew shellenv)"
{{   end -}}
{{ else -}}
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
[ -x "$HOME/.linuxbrew/bin/brew" ] && eval "$($HOME/.linuxbrew/bin/brew shellenv)"

# ra: attach interactive login shells to the persistent tmux session. The ra
# tmux plugin installs auto-attach only as a bash /etc/profile.d snippet, which
# zsh login shells never source. Gated on RA_PLUGIN_TMUX_ENABLED so it is inert
# on any host that is not an ra workstation.
if [[ "${RA_PLUGIN_TMUX_ENABLED:-}" == "true" && -t 1 && -z "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
  # Fall back to a known-good TERM when the client's terminfo isn't installed
  # (Ghostty/Kitty/WezTerm), else tmux refuses to start and would drop the shell.
  infocmp -- "$TERM" &>/dev/null || export TERM=xterm-256color
  # Resolve the start dir; fall back to $HOME if it doesn't exist yet (as the
  # plugin does) — e.g. a repo path configured before it has been cloned.
  ra_tmux_dir="${${RA_PLUGIN_TMUX_START_DIRECTORY:-$HOME}/#\~/$HOME}"
  [[ -d "$ra_tmux_dir" ]] || ra_tmux_dir="$HOME"
  if tmux new-session -A -s "${RA_PLUGIN_TMUX_SESSION_NAME:-main}" -c "$ra_tmux_dir"; then
    unset ra_tmux_dir
    exit 0   # tmux exited cleanly (detach) -> close the login shell (matches plugin)
  fi
  unset ra_tmux_dir
  # tmux failed to start -> fall through to a normal zsh login.
fi
{{ end -}}

# Personal bins on PATH for every login shell — including non-interactive ones
# (e.g. `ssh host cmd`) that skip ~/.zshrc, where 00-path.zsh would otherwise be
# the only thing adding it. Prepended after Homebrew's shellenv so it wins;
# interactive shells re-add and dedupe it in 00-path.zsh via `typeset -U path`.
[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"
