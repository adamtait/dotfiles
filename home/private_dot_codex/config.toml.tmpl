# Codex CLI configuration (~/.codex/config.toml).
# NOTE: MCP servers here mirror the canonical map in
#   .chezmoitemplates/mcp-servers.json.tmpl
# Codex needs TOML (not JSON), so the entries are expressed in TOML below. Keep the two
# in sync — see IMPLEMENTATION-NOTES.md (decision #12) for the tradeoff.

model = "gpt-5-codex"
approval_policy = "on-request"

[mcp_servers.filesystem]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-filesystem", "{{ .chezmoi.homeDir }}/workspace"]

[mcp_servers.git]
command = "uvx"
args = ["mcp-server-git"]

[mcp_servers.fetch]
command = "uvx"
args = ["mcp-server-fetch"]
