;; User-level deps.edn (merged between install-level and project-level by the clj/clojure
;; scripts). General dev tooling plus the Datomic dev/ion + logging aliases the 6pages
;; monolith's script/repl expects.
;; see: https://github.com/seancorfield/dot-clojure

{:mvn/repos
 {"datomic-cloud" {:url "s3://datomic-releases-1fc2183a/maven/releases"}}

 :aliases
 {;; nREPL + CIDER middleware for editor integration:  clj -M:repl
  :repl
  {:extra-deps {nrepl/nrepl       {:mvn/version "1.3.0"}
                cider/cider-nrepl {:mvn/version "0.50.2"}}
   :main-opts  ["-m" "nrepl.cmdline"
                "--middleware" "[cider.nrepl/cider-middleware]"]}

  ;; Datomic Cloud client + Ion dev tooling + REPL helpers:  clj -A:dev
  ;; NOTE: :extra-paths are resolved relative to the invocation dir, so this
  ;; expects a ./dev source dir (e.g. api/monolith/dev).
  :dev
  {:extra-deps {com.datomic/client-cloud        {:mvn/version "1.0.119"}
                com.datomic/ion-dev             {:mvn/version "1.0.298"
                                                 :exclusions  [org.slf4j/slf4j-nop]}
                com.stuartsierra/component.repl {:mvn/version "0.2.0"}
                io.aviso/pretty                 {:mvn/version "0.1.37"}
                spyscope/spyscope               {:mvn/version "0.1.6"}}
   :extra-paths ["dev"]}

  ;; Datomic Ion push/deploy:  clj -M:ion-dev '{:op :push ...}'
  :ion-dev
  {:extra-deps {com.datomic/ion-dev {:mvn/version "1.0.298"}}
   :main-opts  ["-m" "datomic.ion.dev"]}

  ;; Logback + slf4j bridges. Logback config is read off the project classpath
  ;; via ./resources/logging/dev (invocation-dir relative).
  :log
  {:extra-deps {ch.qos.logback/logback-classic {:mvn/version "1.2.3"
                                                 :exclusions  [org.slf4j/slf4j-api]}
                org.slf4j/slf4j-api        {:mvn/version "1.7.14"}
                org.slf4j/jul-to-slf4j     {:mvn/version "1.7.14"}
                org.slf4j/jcl-over-slf4j   {:mvn/version "1.7.14"}
                org.slf4j/log4j-over-slf4j {:mvn/version "1.7.14"}}
   :extra-paths ["resources/logging/dev"]}

  ;; Simple static file server:  clj -M:httpd [port]
  :httpd
  {:extra-deps {nasus/nasus {:mvn/version "0.1.7"}}
   :main-opts  ["-m" "http.server"]}

  ;; Test runner (kaocha):  clj -M:test:run-tests
  :test
  {:extra-deps {com.cognitect/test-runner
                {:git/url "https://github.com/cognitect-labs/test-runner.git"
                 :sha     "209b64504cb3bd3b99ecfec7937b358a879f55c1"}
                lambdaisland/kaocha {:mvn/version "1.91.1392"}}
   :extra-paths ["test" "resources/test"]}

  :run-tests
  {:main-opts ["-m" "kaocha.runner"]}

  ;; New project scaffolding:  clj -M:new app myname/myproj
  :new
  {:extra-deps {com.github.seancorfield/clj-new {:mvn/version "1.2.404"}}
   :main-opts  ["-m" "clj-new.create"]}

  ;; Async profiler:  clj -M:profiler ...
  :profiler
  {:extra-deps {com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.2.2"}}
   :jvm-opts   ["-Djdk.attach.allowAttachSelf"]}}}
