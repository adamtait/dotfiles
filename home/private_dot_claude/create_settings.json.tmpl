{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "includeCoAuthoredBy": true,
  "env": {
    "EDITOR": "emacsclient -a '' -t"
  },
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(gh pr:*)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * master)",
      "Bash(git push * master:*)",
      "Bash(git push origin main)",
      "Bash(git push origin master)"
    ]
  }
}
{{- /* NOTE: Claude Code does NOT read MCP servers from settings.json — user-scoped MCP
       lives in ~/.claude.json and must be registered via `claude mcp add`. That is done
       by run_onchange_after_40-claude-mcp.sh.tmpl, which reads the same canonical map in
       .chezmoitemplates/mcp-servers.json.tmpl. See IMPLEMENTATION-NOTES.md (decision #12). */ -}}
